# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Optional: server-side speech-to-text (Sarvam) — accurate Hindi/Hinglish, any browser.
# Without it, the browser's built-in speech recognition is used.
SARVAM_API_KEY=
# FL_STT_LANG=hi-IN        # or 'unknown' to auto-detect the spoken language
# FL_STT_MODEL=saarika:v2.5

# Sign-in is passkey-based (WebAuthn) — no SMS, no per-message cost, no DLT.
# DEV_MODE=1 enables a passkey-free OTP test code (123456) for local testing & automated tests.
# Set DEV_MODE=0 in production so ONLY passkeys are accepted.
DEV_MODE=1

# WebAuthn relying-party identity. Leave unset locally (derived from the request).
# In production set these to your real domain for stable verification behind a proxy:
# FL_RP_ID=myfamily.up.railway.app
# FL_ORIGIN=https://myfamily.up.railway.app

# Optional: persistent paths (set these on Railway with a volume mounted at /data)
# FL_DB=/data/family.db
# FL_VAULT=/data/vault
